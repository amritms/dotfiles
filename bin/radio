#!/bin/bash
#
# Play internet radio stations.
# > Available genres: `lofi`, `octave`, `salsa`, `mix`, `mellow`, `rock`, `world`, `general`, `hits`, `eurodance`, `80s`.
#
# - Play a radio station by genre:
#
# `radio {{genre}}`
#
# ---
# Author: Nick Plekhanov, https://plekhanov.me
# License: MIT
# https://github.com/nicksp/dotfiles

set -euo pipefail

function show_usage {
  echo "Usage: $(basename "$0") [GENRE]"
  echo ""
  echo "Available genres:"
  echo "  lofi (default), octave, salsa, mix, mellow, rock,"
  echo "  world, general, hits, eurodance, 80s"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message"
}

# Default to lofi if no argument provided
if [ -z "${1:-}" ]; then
  show_usage
  GENRE="lofi"
else
  GENRE="$1"
fi

case "$GENRE" in
  lofi)      url='https://live.hunter.fm/lofi_low' ;;
  octave)    url='https://octaverecords.out.airtime.pro/octaverecords_b' ;;
  salsa)     url='https://latinasalsa.ice.infomaniak.ch/latinasalsa.mp3' ;;
  mix)       url='http://radio3.radio-calico.com:8080/calico' ;;
  mellow)    url='https://stream.radioparadise.com/mellow-flacm' ;;
  rock)      url='https://stream.radioparadise.com/rock-flacm' ;;
  world)     url='https://stream.radioparadise.com/global-flacm' ;;
  general)   url='https://stream.radioparadise.com/flacm' ;;
  hits)      url='https://stream.joyhits.online:8072/joyhits.flac.ogg' ;;
  eurodance) url='https://stream.radioclub80.cl:8032/stream.euro80flac' ;;
  80s)       url='https://stream.radioclub80.cl:8002/clasicos80.flac' ;;
  -h|--help) show_usage; exit 0 ;;
  *)
    echo "Error: Unknown genre '$GENRE'"
    echo ""
    show_usage
    exit 1
    ;;
esac

exec mpv --quiet --term-status-msg='${media-title} - ${metadata/artist}' "$url"