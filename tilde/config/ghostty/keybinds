keybind = global:f12=toggle_quick_terminal
#map cmd+` no_op
# Customizing the appearance (Optional)
# Explicitly force the quick terminal to target the currently active monitor
quick-terminal-screen = main
# Fixes a macOS sizing calculation bug when Ghostty launches headless in the background
initial-window = true
# Define height (40%) and width (100%)
quick-terminal-position = top
quick-terminal-size = 40%, 100%
quick-terminal-autohide = true
quick-terminal-animation-duration = 0

keybind=super+shift+\=new_split:right
keybind=super+shift+-=new_split:down

keybind = ctrl+n=new_window

keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top
keybind = ctrl+l=goto_split:right

keybind = ctrl+a>h=new_split:left
keybind = ctrl+a>j=new_split:down
keybind = ctrl+a>k=new_split:up
keybind = ctrl+a>l=new_split:right
keybind = ctrl+a>f=toggle_split_zoom

keybind = ctrl+a>n=next_tab
keybind = ctrl+a>p=previous_tab

keybind = super+r=reload_config

window-save-state = always
