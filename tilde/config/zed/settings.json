{
    // Vim
    "ssh_connections": [
        {
            "host": "10.0.0.108",
            "args": [],
            "projects": []
        },
        {
            "host": "10.0.0.151",
            "username": "amritms",
            "args": [],
            "projects": [],
            "nickname": "Aimeos-V1"
        },
        {
            "host": "10.0.0.150",
            "username": "root",
            "args": [],
            "projects": [
                {
                    "paths": [
                        "/var/www/bagisto"
                    ]
                }
            ],
            "nickname": "Bagisto-V1"
        }
    ],
    "base_keymap": "VSCode",
    "vim_mode": true,

    // vim combo keys help
    "which_key": {
        "enabled": true,
    },

    // Looks / Editor
    "ui_font_size": 16.0,
    "buffer_font_size": 16.0,
    "ui_font_family": "IBM Plex Sans",
    "buffer_font_family": "JetBrains Mono",
    "icon_theme": {
        "mode": "system",
        "light": "Catppuccin Latte",
        "dark": "Catppuccin Mocha",
    },
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "One Dark",
    },
    "buffer_line_height": { "custom": 1.5999999046325684 },
    "cursor_blink": false,
    "show_whitespaces": "selection",
    "preferred_line_length": 120,
    "autosave": "off",
    "format_on_save": "on",
    "vertical_scroll_margin": 4.0,
    "relative_line_numbers": "enabled",
    "when_closing_with_no_tabs": "keep_window_open",
    "show_wrap_guides": false,
    "colorize_brackets": true,
    "title_bar": {
        "show_menus": false,
        "show_sign_in": true,
        "show_user_picture": false,
        "show_onboarding_banner": false,
        "show_project_items": true,
        "show_branch_name": true,
    },
    "debugger": {
        "button": false,
    },

    // Indentation and wrapping
    "tab_size": 4,
    "wrap_guides": [120],
    "indent_guides": {
        "enabled": true,
        "coloring": "fixed",
        "active_line_width": 2,
    },

    // Terminal
    "terminal": {
        "minimum_contrast": 45.0,
        "font_family": "FiraCode Nerd Font Mono",
        "font_weight": 400.0,
        "blinking": "on",
        "cursor_shape": "block",
        "shell": "system",
        "button": false,
        "font_size": 15.0,
        "line_height": { "custom": 1.8 },
    },

    // Files, indexing, etc.
    "file_scan_exclusions": ["_model_helpers.php", ".DS_Store"],
    "file_types": {
        "Blade": ["*.blade.php"],
    },

    // Layouts
    "project_panel": {
        "hide_hidden": false,
        "hide_root": true,
        "indent_guides": {
            "show": "never",
        },
        "show_diagnostics": "errors",
        "auto_fold_dirs": true,
        "starts_open": true,
        "indent_size": 24.0,
        "folder_icons": true,
        "file_icons": true,
        "entry_spacing": "comfortable",
        "button": false,
        "dock": "right",
        "default_width": 360,
    },
    "notification_panel": { "dock": "left" },

    // Clean UI
    "preview_tabs": { "enabled": false },
    "tabs": {
        "show_close_button": "hover",
        "close_position": "right",
        "file_icons": false,
        "git_status": false,
    },
    "tab_bar": {
        "show": true,
        "show_tab_bar_buttons": false,
        "show_nav_history_buttons": false,
    },
    "toolbar": {
        "code_actions": false,
        "agent_review": false,
        "breadcrumbs": false,
        "selections_menu": false,
        "quick_actions": false,
    },

    // Statusbar
    "status_bar": {
        "line_endings_button": false,
        "active_language_button": true,
        "cursor_position_button": false,
    },
    "git_panel": { "dock": "left",
                   "button": false },
    "collaboration_panel": { "dock": "left",
                             "button": false },
    "search": { "button": false },
    "outline_panel": { "dock": "left",
                       "button": false },

    // Scrollbar
    "scrollbar": {
        "axes": {
            "horizontal": true,
            "vertical": true,
        },
        "selected_symbol": false,
        "selected_text": false,
        "search_results": true,
        "cursors": true,
        "git_diff": false,
    },

    // Languages, LSP
    "languages": {
        "JSONC": { "tab_size": 4 },
        "JSON": { "tab_size": 4 },
        "PHP": {
            "format_on_save": "on",
            // "formatter": "language_server",
            "language_servers": ["intelephense", "!phptools", "!phpactor"],
            "formatter": {
                "external": {
                    "command": "bash",
                    "arguments": [
                        "-c",
                        "temp=$(mktemp) && cat > $temp && pint --quiet --config ~/.config/pint/laravel.json $temp && cat $temp",
                    ],
                },
            },
        },
        "Blade": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "blade-formatter",
                    "arguments": [
                        "--stdin",
                        "--wrap-line-length",
                        "9999",
                        "--wrap-attributes",
                        "preserve-aligned",
                        "--sort-tailwindcss-classes",
                    ],
                },
            },

            // "formatter": {
            //     "external": {
            //         "command": "blade-formatter",
            //         "arguments": ["--stdin", "--wrap-line-length", "9999", "--wrap-attributes", "preserve-aligned"],
            //     },
            // },
        },
        "Vue.js": { "formatter": { "language_server": { "name": "vue-language-server" } } },
    },
    "lsp": {
        "intelephense": {
            "settings": {
                "intelephense.files.associations": ["*.php", "*.blade.php"],
                "intelephense.environment.phpVersion": "8.2.0",
                "intelephense.stubs": [
                    "apache",
                    "bcmath",
                    "bz2",
                    "calendar",
                    "com_dotnet",
                    "Core",
                    "ctype",
                    "curl",
                    "date",
                    "dba",
                    "dom",
                    "enchant",
                    "exif",
                    "FFI",
                    "fileinfo",
                    "filter",
                    "fpm",
                    "ftp",
                    "gd",
                    "gettext",
                    "gmp",
                    "hash",
                    "iconv",
                    "imap",
                    "intl",
                    "json",
                    "ldap",
                    "libxml",
                    "mbstring",
                    "meta",
                    "mysqli",
                    "oci8",
                    "odbc",
                    "openssl",
                    "pcntl",
                    "pcre",
                    "PDO",
                    "pdo_ibm",
                    "pdo_mysql",
                    "pdo_pgsql",
                    "pdo_sqlite",
                    "pgsql",
                    "Phar",
                    "posix",
                    "pspell",
                    "readline",
                    "Reflection",
                    "session",
                    "shmop",
                    "SimpleXML",
                    "snmp",
                    "soap",
                    "sockets",
                    "sodium",
                    "SPL",
                    "sqlite3",
                    "standard",
                    "superglobals",
                    "sysvmsg",
                    "sysvsem",
                    "sysvshm",
                    "tidy",
                    "tokenizer",
                    "xml",
                    "xmlreader",
                    "xmlrpc",
                    "xmlwriter",
                    "xsl",
                    "Zend OPcache",
                    "zip",
                    "zlib",
                ],
            },
        },
        "phptools": {
            "initialization_options": {
                "php.format.codeStyle": "Laravel",
                "php.format.rules.addCommaAfterLastArrayElement": true,
                "php.format.rules.alignConsecutiveAssignments": true,
                "php.format.rules.alignConstants": true,
                "php.format.rules.alignEnumCases": true,
                "php.format.rules.alignMatchArmBodies": true,
                "php.format.rules.alignProperties": true,
                "php.format.rules.arrayInitializersAlignKeyValuePairs": true,
                "php.format.rules.spaceAfterUnaryNot": true,
            },
        },
    },
    "inlay_hints": {
        "show_background": true,
        "enabled": true,
    },

    // Git, source control
    "git": {
        "inline_blame": { "enabled": false },
        "git_gutter": "tracked_files",
    },

    // AI
    "show_edit_predictions": true,
    "edit_predictions": {
        "provider": "zed",
        "mode": "subtle",
    },
    "agent": {
        "tool_permissions": {
            "default": "allow"
        },
        "inline_assistant_model": {
            "provider": "zed.dev",
            "model": "claude-sonnet-4-5",
        },
        "default_profile": "ask",
        "default_model": {
            "provider": "zed.dev",
            "model": "claude-sonnet-4-5",
        },
        "dock": "left",
    },
    "language_models": {
        "ollama": {
            "api_url": "http://localhost:11434",
        },
    },

    // Other
    "inline_code_actions": false,
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
}
